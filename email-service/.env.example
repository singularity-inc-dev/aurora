# Copy to .env (git ignores it) and fill in. Never commit the real file.
# On the server this file is written by deploy/install.sh; secrets come from files.
PAPERCLIP_URL=http://127.0.0.1:3100
# Paperclip's public address (authenticated mode), e.g. https://team.example.com
PAPERCLIP_PUBLIC_URL=
VT_COMPANY_ID=
# Secrets: give a file path (preferred) or, except for the GitHub token, the value.
# A board API key, only needed when Paperclip runs in authenticated mode.
PAPERCLIP_API_KEY_FILE=
# Any SMTP account. Port 587 = STARTTLS (set SMTP_REQUIRE_TLS=true), 465 = TLS.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASS_FILE=
MAIL_FROM=Vision and Tom <briefing@localhost>
LISTEN_HOST=127.0.0.1
LISTEN_PORT=3299
POLL_SECONDS=60
# Approve in GitHub mode. The token can push and merge; only a file is accepted.
GITHUB_TOKEN_FILE=
GITHUB_API_URL=https://api.github.com
GITHUB_GIT_URL=https://github.com
GITHUB_SYNC_MINUTES=10
# Where the email service keeps its own files (a git mirror used to publish).
STATE_DIR=.state
