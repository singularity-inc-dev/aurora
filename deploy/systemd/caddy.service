[Unit]
Description=Caddy (HTTPS for Aurora)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=caddy
Group=caddy
EnvironmentFile=@ETC@/caddy.env
Environment=XDG_DATA_HOME=@VTROOT@/var/lib/caddy
Environment=XDG_CONFIG_HOME=@VTROOT@/var/lib/caddy
ExecStart=@OPT@/bin/caddy run --environ=false --config @ETC@/Caddyfile --adapter caddyfile
ExecReload=@OPT@/bin/caddy reload --config @ETC@/Caddyfile --adapter caddyfile --force
Restart=always
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
# Sees only its own user's processes (Paperclip puts run tokens on command lines).
ProtectProc=invisible
PrivateTmp=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
