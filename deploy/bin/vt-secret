#!/usr/bin/env bash
# Store one secret on the server without it showing on screen or in shell history.
#   sudo vt-secret smtp-password       your email account's password (or app password)
#   sudo vt-secret github-token        GitHub token that can push and merge (Approve only)
#   sudo vt-secret github-read-token   GitHub token that can only read (agents fetch the code)
. "$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)/lib/common.sh"
need_root
case "${1:-}" in
  smtp-password | github-token | github-read-token) ;;
  *) die "usage: sudo vt-secret smtp-password|github-token|github-read-token" ;;
esac
if [ -t 0 ]; then
  read -r -s -p "Paste the value for $1 and press Enter (nothing will show): " value; echo
else
  read -r value
fi
[ -n "$value" ] || die "nothing was entered; nothing was changed"
write_secret "$1" "$value"
unset value
echo "Saved $1 (only root can read it)."
if [ "$1" != "github-read-token" ] && ! rehearsal && systemctl is-enabled --quiet vt-email.service 2>/dev/null; then
  systemctl restart vt-email.service && echo "The email service was restarted to use it."
fi
