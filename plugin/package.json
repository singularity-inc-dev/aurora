{
  "name": "@vision-and-tom/paperclip-plugin",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "description": "Aurora: each owner directs their own agent; nothing shared changes until its owner approves.",
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node --watch-path=src esbuild.config.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=24.11"
  },
  "dependencies": {
    "@paperclipai/plugin-sdk": "2026.1012.0"
  },
  "devDependencies": {
    "@paperclipai/shared": "2026.1012.0",
    "@types/node": "24.10.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
